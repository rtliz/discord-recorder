DISCORD_TOKEN=
CLIENT_ID=
# ไม่บังคับ: user id ที่สั่งบอทได้ คั่นด้วย comma (ว่าง = ทุกคนที่มีสิทธิ์ Manage Server)
ALLOWED_USER_IDS=
# server id ที่ใช้บอทได้ คั่นด้วย comma (ว่าง = ทุก server; ควรปิด Public Bot)
ALLOWED_GUILD_IDS=
# true = ตอนบอทเริ่ม ให้ออกจาก server ที่ไม่อยู่ใน ALLOWED_GUILD_IDS (ระวังพิมพ์ id ผิด)
LEAVE_UNLISTED=false
# index ของจอจาก: ffmpeg -f avfoundation -list_devices true -i ""
SCREEN_DEVICE=2

# อัปโหลดขึ้น Google Drive (ตั้งแล้วบอทจะส่งลิงก์แทนไฟล์) — ดูขั้นตอนใน README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=your-drive-folder-id

# ไม่บังคับ: user id ที่การแชร์หน้าจอจะ trigger อัดวิดีโออัตโนมัติ (ว่าง = ทุกคน)
AUTO_SCREEN_USER_IDS=
# ค่าเริ่มต้นของ "เมื่อมีคนแชร์จอ" สำหรับ server ที่ยังไม่ได้ตั้งค่าใน Discord (/settings)
# true = ส่งการ์ด (กดปุ่ม 🔴 แล้วถึงอัด), auto = อัดอัตโนมัติถ้าคนแชร์มีตัวอัดออนไลน์ (ต้องตั้ง PUBLIC_URL), false = ปิด
SHARE_CARDS=false
# กรอบอัดเริ่มต้น (server ที่ยังไม่ได้ตั้งค่า): screen = ทั้งจอ, discord = แค่หน้าต่าง Discord
#CAPTURE_AREA=screen
# ชื่อเดิม ใช้เฉพาะเมื่อไม่ได้ตั้ง SHARE_CARDS: true = อัดอัตโนมัติ
AUTO_SCREEN=false
AUTO_SCREEN_MIN_MEMBERS=2
# โหมดจอ: screen | window (เฉพาะ Mac) | browser (ต้องตั้ง PUBLIC_URL)
SCREEN_MODE=screen
# ไม่บังคับ: voice channel id ที่ให้เฝ้า คั่นด้วย comma (ว่าง = ทุกห้อง)
AUTO_SCREEN_CHANNEL_IDS=
# timezone ของช่วงเวลาอัดอัตโนมัติ
TIMEZONE=Asia/Bangkok
# แอปที่โหมด "หน้าต่าง" จะอัด
SCREEN_WINDOW_APP=Discord

# ไม่บังคับ: URL สาธารณะของบอท สำหรับหน้าอัดจอในเบราว์เซอร์ (ไม่มี / ท้าย) ว่าง = ปิดฟีเจอร์นี้
# ทดสอบในเครื่องใช้ http://localhost:8080 ได้ แต่ให้ผู้แชร์เข้าถึงได้จริงต้องใช้ https (หรือ tunnel)
PUBLIC_URL=
# พอร์ตของ HTTP server (ค่าเริ่มต้น 8080 เมื่อมี PUBLIC_URL)
# ตั้งเฉพาะเมื่อใช้ k8s health check โดยไม่มี PUBLIC_URL (เปิดแค่ /healthz) ผู้ใช้ Mac ไม่ต้องตั้ง จะได้ไม่เปิดพอร์ตโดยไม่จำเป็น
# HTTP_PORT=8080
# จำนวนการเชื่อมต่อพร้อมกันสูงสุดของ HTTP server (ค่าเริ่มต้น 512) ตัวอัดที่ออนไลน์ใช้เครื่องละ 1
# HTTP_MAX_CONNECTIONS=512
# ขนาดรวมสูงสุดของไฟล์ต่อการอัดจอ 1 ครั้ง (MB)
CAPTURE_MAX_MB=3072
# ขนาดรวมของชิ้นวิดีโอที่ค้างในเครื่องจากทุกการอัดจอ (MB) เกินแล้วการอัดจบพร้อมส่งเท่าที่ได้
CAPTURE_TOTAL_MB=8192
# true = หลังอัปโหลด Google Drive สำเร็จทุกไฟล์ ให้ลบโฟลเดอร์ในเครื่อง (ต้องตั้ง GOOGLE_REFRESH_TOKEN ด้วย)
DELETE_AFTER_UPLOAD=false

# ตัวอัดบนเครื่องผู้ใช้ (ใช้เมื่อตั้ง PUBLIC_URL): ไฟล์เก็บ credential ของเครื่องที่จับคู่แล้ว (เก็บเฉพาะ hash)
# ใน k8s ต้องอยู่บน PVC (data/) ไม่งั้นต้องจับคู่ใหม่ทุกครั้งที่ pod restart
AGENTS_FILE=data/agents.json
# false = ปิดการจับคู่ด้วยรหัส 6 หลัก (ใช้สำหรับ npm run agent) เหลือแค่คำสั่งติดตั้งที่มี token; ค่าเริ่มต้นเปิด
AGENT_CODE_PAIRING=true
